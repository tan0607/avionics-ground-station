# Python
.venv/
__pycache__/
*.pyc

# Node / frontend
node_modules/
dashboard/node_modules/
dashboard/dist/

# Agent machine-local settings (have absolute hook paths)
.claude/settings.local.json
.codex/hooks.json

# Offline map tiles (large). Ignore ad-hoc extracts by default...
*.pmtiles
# ...but DO ship the launch-site basemap: it must be present for the offline
# build (DESIGN_SPECS §1), and Protomaps daily builds expire in ~7 days so this
# exact cut is not reliably regenerable later. Re-cut via go-pmtiles if needed.
!dashboard/public/basemap.pmtiles

# OS
.DS_Store

# Flight data — runtime session logs (raw.log/CSVs), regenerable, can get large.
# Archive flights/ separately rather than committing per-run data.
flights/
