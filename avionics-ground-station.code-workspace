{
    // Open THIS file (File > Open Workspace from File...), not the plain folder.
    //
    // Single root now. This used to carry a second root for firmware/, because the
    // PlatformIO extension only activates when platformio.ini sits at a workspace
    // root. That PlatformIO project is gone -- firmware/ is two Arduino sketches
    // built with arduino-cli (see firmware/README.md), which needs no extension and
    // no root of its own.
    "folders": [
        {
            "name": "avionics-ground-station",
            "path": "."
        }
    ],
    "settings": {
        "files.associations": {
            "*.ino": "cpp"
        },
        // arduino-cli writes build/ next to a sketch when you compile without
        // --output-dir: a couple of MB of regenerable binaries per sketch, per
        // board. Gitignored (firmware/.gitignore); excluded here so it does not
        // pollute search results either.
        "search.exclude": {
            "**/build": true,
            "**/node_modules": true,
            "**/dist": true
        }
    },
    "extensions": {
        "recommendations": [
            "ms-vscode.cpptools"
        ]
    }
}
