{
    // IntelliSense for the two Arduino sketches in firmware/. Both are ESP32 parts
    // built with arduino-cli, so the include paths point at the esp32 core the
    // Arduino IDE / arduino-cli already downloaded into ~/Library/Arduino15.
    //
    // Two configurations because the boards differ: the flight computer is an
    // ESP32-S3 (xtensa-esp32s3-elf) and the ground station is a classic ESP32
    // (xtensa-esp32-elf). Pick one in the status bar; the difference that matters
    // to IntelliSense is the variant pins header and the compiler triple.
    //
    // This file previously configured a 5 V Uno / ATmega328P for an Arduino sketch
    // under firmware/arduino/, and disclaimed the PlatformIO targets on the grounds
    // that PlatformIO generated its own config. Both of those are gone -- see
    // firmware/README.md.
    //
    // The core version is pinned in these paths. After `arduino-cli core upgrade`,
    // update 3.3.11 here or IntelliSense goes red while the build stays fine.
    "configurations": [
        {
            "name": "Flight computer (ESP32-S3)",
            "includePath": [
                "${workspaceFolder}/firmware/MRCC_FlightComputer",
                "${workspaceFolder}/firmware/MRCC_FlightComputer/src",
                "${env:HOME}/Library/Arduino15/packages/esp32/hardware/esp32/3.3.11/cores/esp32",
                "${env:HOME}/Library/Arduino15/packages/esp32/hardware/esp32/3.3.11/variants/esp32s3",
                "${env:HOME}/Library/Arduino15/packages/esp32/hardware/esp32/3.3.11/libraries/**",
                "${env:HOME}/Documents/Arduino/libraries/**"
            ],
            "defines": [
                "ARDUINO=10819",
                "ARDUINO_ARCH_ESP32",
                "ESP32",
                "ARDUINO_ESP32S3_DEV"
            ],
            "compilerPath": "${env:HOME}/Library/Arduino15/packages/esp32/tools/esp-x32/2601/bin/xtensa-esp32s3-elf-g++",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-x64"
        },
        {
            "name": "Ground station (ESP32)",
            "includePath": [
                "${workspaceFolder}/firmware/MRCC_GroundStation",
                "${env:HOME}/Library/Arduino15/packages/esp32/hardware/esp32/3.3.11/cores/esp32",
                "${env:HOME}/Library/Arduino15/packages/esp32/hardware/esp32/3.3.11/variants/esp32",
                "${env:HOME}/Library/Arduino15/packages/esp32/hardware/esp32/3.3.11/libraries/**",
                "${env:HOME}/Documents/Arduino/libraries/**"
            ],
            "defines": [
                "ARDUINO=10819",
                "ARDUINO_ARCH_ESP32",
                "ESP32",
                "ARDUINO_ESP32_DEV"
            ],
            "compilerPath": "${env:HOME}/Library/Arduino15/packages/esp32/tools/esp-x32/2601/bin/xtensa-esp32-elf-g++",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-x64"
        }
    ],
    "version": 4
}
